# =============================================================================
# ReachBuzz — environment template
#
# Copy to .env and fill in real values. NEVER commit .env, and never put real
# credentials in this example file.
#
#   cp .env.example .env
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# =============================================================================

# --- Django ------------------------------------------------------------------
DEBUG=True
SECRET_KEY=
DJANGO_SETTINGS_MODULE=config.settings.local
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
LANGUAGE_CODE=en-us
TIME_ZONE=UTC
LOG_LEVEL=INFO

# --- Database ----------------------------------------------------------------
# postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rebuzz
DB_CONN_MAX_AGE=60

# --- Redis / Celery ----------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=False
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=240
# Transport options as JSON. Empty for a standard Redis setup.
CELERY_BROKER_TRANSPORT_OPTIONS={}

# --- Local development without Redis (Windows) -------------------------------
# Celery's filesystem transport runs a real worker with no broker to install.
# Development only: it polls a directory and does not scale. Production uses
# Redis. Requires pywin32 on Windows (already in requirements/dev.txt).
#
# CELERY_BROKER_URL=filesystem://
# CELERY_BROKER_TRANSPORT_OPTIONS={"data_folder_in": "C:/temp/wbm-queue", "data_folder_out": "C:/temp/wbm-queue", "processed_folder": "C:/temp/wbm-processed", "store_processed": true}
# WHATSAPP_RATE_LIMIT_BACKEND=null

# --- WhatsApp provider -------------------------------------------------------
# "mock" simulates sending locally. Switch to "meta" only once the Meta
# credentials below are filled in and the WABA is approved for sending.
WHATSAPP_PROVIDER=mock

# --- Per-organization messaging credentials -----------------------------------
# Encrypts each customer's WhatsApp access token at rest. Generate one with:
#   python manage.py generate_encryption_key
# Leave empty and a key is derived from SECRET_KEY: fine for development, a
# hazard in production, because rotating SECRET_KEY would then make every
# stored token unreadable with no way back except re-entering them.
FIELD_ENCRYPTION_KEY=

# Whether an organization must connect its own WhatsApp sender before it can
# send anything. False falls back to the META_* credentials below, which is what
# keeps a single-business installation working. Set it True when running this as
# a platform: otherwise a customer with no sender of their own would send on
# your number, your messaging limit and your sender reputation.
WHATSAPP_REQUIRE_MESSAGING_ACCOUNT=False

# --- SMS ----------------------------------------------------------------------
# Only "mock" is implemented; it sends nothing anywhere. A real gateway needs an
# account, a registered sender id and, in several countries, regulatory
# paperwork, and a half-written integration against one is worse than none.
SMS_PROVIDER=mock

# The originator a recipient sees, installation-wide. Empty means "let the
# gateway decide", which is normal: many networks override it, and several
# require it to be registered in advance.
SMS_SENDER_ID=

# How often the mock pretends a send failed, so the retry path can be seen
# locally. Must be 0.0 in production.
MOCK_SMS_FAILURE_RATE=0.0

# --- Payment provider ---------------------------------------------------------
# "mock" is the only implementation. It moves no money, accepts no card details,
# and honours idempotency keys the way a real gateway does, so the collection
# and dunning paths can be exercised locally. Adding a real gateway means
# merchant credentials and a live account; a half-written integration against
# one is worse than an honest absence.
PAYMENT_PROVIDER=mock

# The HMAC key the provider signs its webhooks with, verified over the raw body.
# Leave empty in development; the mock falls back to a fixed development secret.
# In production this must be set to the value from the provider's dashboard.
PAYMENT_WEBHOOK_SECRET=

# How often the mock pretends a charge failed, so the decline and retry paths
# can be seen locally. Must be 0.0 in production.
MOCK_PAYMENT_FAILURE_RATE=0.0

# --- Meta WhatsApp Business Platform Cloud API -------------------------------
# Obtain these from the Meta App dashboard / WhatsApp Manager.
# META_API_VERSION must match a Graph API version that Meta currently supports;
# check the official docs at integration time rather than guessing.
META_API_VERSION=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_APP_ID=
META_APP_SECRET=
# Free-form string you choose; it must match what you enter in the Meta
# webhook configuration screen.
META_WEBHOOK_VERIFY_TOKEN=

# --- Sending behaviour -------------------------------------------------------
# Self-imposed ceiling. Keep it at or below the throughput your WABA tier
# permits; this throttles our own sending and never bypasses Meta's limits.
WHATSAPP_SEND_RATE_PER_SECOND=10
WHATSAPP_MAX_RETRIES=3
WHATSAPP_RETRY_BACKOFF_SECONDS=10
WHATSAPP_REQUEST_TIMEOUT=30
# "redis" shares one token bucket across every worker; "null" disables limiting.
WHATSAPP_RATE_LIMIT_BACKEND=redis

# --- Mock provider simulation (development only) -----------------------------
MOCK_PROVIDER_FAILURE_RATE=0.0
MOCK_PROVIDER_LATENCY_SECONDS=0.0
# Stand in for the provider's delivery webhooks so the full lifecycle can be
# demonstrated locally. Recorded as "simulated", never as a real webhook.
MOCK_PROVIDER_SIMULATE_CALLBACKS=True
MOCK_PROVIDER_CALLBACK_DELAY=3
MOCK_PROVIDER_READ_RATE=0.6

# --- Domain defaults ---------------------------------------------------------
# ISO 3166-1 alpha-2 region used to interpret numbers typed without a "+".
DEFAULT_COUNTRY_CODE=NP
CSV_IMPORT_MAX_BYTES=5242880
CSV_IMPORT_MAX_ROWS=20000
CAMPAIGN_MAX_RECIPIENTS=5000

# --- Branding ----------------------------------------------------------------
SITE_NAME=ReachBuzz
SITE_TAGLINE=Business Messaging & Automation Platform
SITE_DESCRIPTION=A WhatsApp Business messaging and campaign management platform for businesses to send, manage, and track customer communications.
BUSINESS_DISPLAY_NAME=
SUPPORT_EMAIL=

# --- Sessions ----------------------------------------------------------------
# How long a session survives without activity. Eight hours by default: long
# enough for a working day, short enough that an unattended browser expires.
SESSION_COOKIE_AGE=28800

# --- Sign-in throttling -------------------------------------------------------
# Applies to the HTML sign-in form. THROTTLE_LOGIN below covers the REST login;
# both doors need a lock, or the limit can be walked around by posting where a
# browser posts. Counted per client address rather than per account, so knowing
# an operator's email address is not enough to lock them out. Set the limit to
# 0 to disable.
LOGIN_ATTEMPT_LIMIT=10
LOGIN_ATTEMPT_WINDOW_SECONDS=300

# --- Sign-up throttling -------------------------------------------------------
# Accounts one network may create per window. Registration is unauthenticated
# and mails an address the caller chooses, so it is both a way to fill the
# database and a way to send our mail to someone who never asked for it.
# Raise it if you expect a single office to sign up many colleagues at once.
SIGNUP_LIMIT=5
SIGNUP_WINDOW_SECONDS=3600

# --- Outbound email throttling ------------------------------------------------
# Covers password reset and re-sending a confirmation link. Either one mails on
# demand, so either one is a way to bury an inbox using our sending reputation.
OUTBOUND_EMAIL_LIMIT=5
OUTBOUND_EMAIL_WINDOW_SECONDS=900

# --- Rate limiting (DRF throttle scopes) -------------------------------------
THROTTLE_LOGIN=10/min
THROTTLE_CSV_IMPORT=10/hour
THROTTLE_CAMPAIGN_LAUNCH=30/hour

# --- Production only ---------------------------------------------------------
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# REDIS_CACHE_URL=redis://localhost:6379/1
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=
