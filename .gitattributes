# Normalize line endings.
#
# This machine has core.autocrlf=true, so without this file every checkout on
# Linux (CI, and any production host) would see CRLF in the repository. Text is
# stored as LF and checked out however the platform prefers.
* text=auto eol=lf

# Explicit, so a misdetection cannot corrupt these.
*.py       text eol=lf
*.pyi      text eol=lf
*.html     text eol=lf
*.css      text eol=lf
*.js       text eol=lf
*.json     text eol=lf
*.md       text eol=lf
*.txt      text eol=lf
*.toml     text eol=lf
*.ini      text eol=lf
*.cfg      text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.csv      text eol=lf
*.sql      text eol=lf
.env.example text eol=lf
Makefile   text eol=lf

# Windows scripts must keep CRLF or cmd.exe misreads them.
*.bat      text eol=crlf
*.cmd      text eol=crlf
*.ps1      text eol=crlf

# Never touch these.
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.pdf      binary
*.woff     binary
*.woff2    binary
*.ttf      binary
*.eot      binary
*.zip      binary
*.gz       binary

# Generated files: collapse them in diffs and exclude from language stats.
*.min.js   linguist-vendored
*.min.css  linguist-vendored
**/migrations/*.py linguist-generated=false
